{
  "name": "@dsh-external/dsh-remote-workspace",
  "version": "0.0.1",
  "description": "远程站点与远程工作区（SSH/SFTP）：连接管理、统一添加工作区、远程文件读写",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.sh"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hefulalala/dsh-remote-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/Hefulalala/dsh-remote-workspace/issues"
  },
  "homepage": "https://github.com/Hefulalala/dsh-remote-workspace#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.1 <4.1.0-0 || >=4.1.0-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  }
}
